# Copy this file to /root/.config/school_syt/baota-release.env on the server.
# Do not place the real file in this repository.
#
# Create the directory and both protected files as root:
#   install -d -m 700 /root/.config/school_syt
#   install -m 600 /dev/null /root/.config/school_syt/baota-api.key
#   install -m 600 scripts/baota-release.env.example /root/.config/school_syt/baota-release.env
#
# Generate the API key in Baota: Settings -> API. Its IP whitelist must include
# 127.0.0.1. The URL must use the panel's local loopback address and include its
# security entry, never a public host.
BT_PANEL_URL='https://127.0.0.1:35889/<your-baota-security-entry>'
BT_API_KEY_FILE='/root/.config/school_syt/baota-api.key'

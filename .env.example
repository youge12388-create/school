DATABASE_PATH=/data/app.sqlite
UPLOAD_DIR=/data/uploads
IMPORT_DIR=/data/imports
APP_KEY_PATH=/data/app.key
SESSION_TTL_HOURS=24
TRUST_PROXY=false
MAX_UPLOAD_MB=20

# WeCom self-built application. Keep the secret server-side and never prefix it with NEXT_PUBLIC_.
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://check.medicalchinaway.com/api/auth/wecom/callback

# AI 选校（仅在服务器配置；不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Additional OpenAI-compatible HTTPS API base URLs, separated by commas.
# AI_PROVIDER_ALLOWED_BASE_URLS=https://approved-gateway.example.com/v1
# AI_SCREENING_WORKBOOK_PATH=完整的招生表路径
# AI_SCREENING_SHARED_DIR=可持久化且所有服务实例共享的名单版本目录
# AI_SCREENING_PARTNERS_PATH=可选的内部合作台账 JSON 路径
